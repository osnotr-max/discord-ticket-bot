{
  "name": "honeylua",
  "version": "2.5.1",
  "private": true,
  "description": "Low-memory Discord support ticket bot with audit-focused transcripts and admin context tools.",
  "type": "module",
  "scripts": {
    "start": "bun --smol run src/index.ts",
    "build": "bun build src/index.ts --target bun --minify --outfile dist/honeylua.js",
    "check": "bun build src/index.ts --target bun --outfile /tmp/honeylua-check.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
