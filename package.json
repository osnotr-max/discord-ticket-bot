{
  "name": "staff-honey",
  "version": "1.0.0",
  "private": true,
  "description": "Low-memory Staff Honey support service using Bun's native WebSocket and fetch APIs.",
  "type": "module",
  "scripts": {
    "start": "bun --smol run src/index.ts",
    "build": "bun build src/index.ts --target bun --minify --outfile dist/staff-honey.js",
    "check": "bun build src/index.ts --target bun --outfile /tmp/staff-honey-check.js"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}