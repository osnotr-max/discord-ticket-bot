{
  "name": "honeylua",
  "version": "2.4.0",
  "private": true,
  "description": "Low-memory Honeylua support service with an optimized text-and-sticker ticket transcript audit system.",
  "type": "module",
  "scripts": {
    "start": "bun --smol run src/index.ts",
    "build": "bun build src/index.ts --target bun --minify --outfile dist/honeylua.js",
    "check": "bun build src/index.ts --target bun --outfile /tmp/honeylua-check.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
