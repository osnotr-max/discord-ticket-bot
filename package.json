{
  "name": "discord-ticket-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Low-memory Discord ticket bot using Bun's native WebSocket and fetch APIs.",
  "type": "module",
  "scripts": {
    "start": "bun --smol run src/index.ts",
    "build": "bun build src/index.ts --target bun --minify --outfile dist/ticket-bot.js",
    "check": "bun build src/index.ts --target bun --outfile /tmp/ticket-bot-check.js"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}