{
  "name": "honeylua",
  "version": "2.7.0",
  "private": true,
  "description": "Hardened low-memory Discord support ticket bot with minimized production builds and bounded runtime state.",
  "type": "module",
  "scripts": {
    "start": "bun --smol run src/index.ts",
    "build": "bun build src/index.ts --target bun --minify --sourcemap=none --outfile dist/honeylua.js",
    "check": "bun build src/index.ts --target bun --outfile /tmp/honeylua-check.js",
    "typecheck": "tsc --noEmit",
    "release": "bun build src/index.ts --target bun --minify --sourcemap=none --outfile dist/honeylua.js"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
